# 自用 amd64；主機預設只綁 loopback，不直接暴露公網。
FOURGTV_BIND=127.0.0.1
FOURGTV_PORT=18080
PORT=8080

# 本機 ubuntu 的 UID/GID 為 1001。其他主機請用 id -u / id -g 確認。
FOURGTV_UID=1001
FOURGTV_GID=1001
FOURGTV_DATA_DIR=./data
TZ=Asia/Taipei

# 僅第一次啟動採用；之後以 data/.docker-base-path 為準。
# 留空：產生隨機隱藏路徑。自訂範例：/my-private-path。off：停用前綴。
# 不可有尾斜線；不要使用可猜測的自訂路徑。
BASE_PATH=
